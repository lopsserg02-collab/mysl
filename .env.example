# Signs short-lived realtime tokens shared by the web app and the realtime server
REALTIME_SECRET=
# Where the browser reaches the realtime server
NEXT_PUBLIC_REALTIME_URL=ws://localhost:1234
REALTIME_PORT=1234
# Data layer: "local" (JSON file in .data/, for development) or "postgres" (Supabase or any Postgres)
DATA_LAYER=local
# Postgres connection string; on Supabase: Project Settings -> Database -> Connection string (session pooler)
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
