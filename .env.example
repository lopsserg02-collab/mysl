# Signs short-lived realtime tokens shared by the web app and the realtime server
REALTIME_SECRET=
# Where the browser reaches the realtime server
NEXT_PUBLIC_REALTIME_URL=ws://localhost:1234
REALTIME_PORT=1234
# Data layer: "local" (JSON file in .data/, for development) or "postgres" (any Postgres; plain Postgres needs db/dev/supabase-stub.sql, applied by `npm run db:migrate:dev`)
DATA_LAYER=local
# Postgres connection string
DATABASE_URL=
# Public address of the site, used in sign-in links. Required in production; in development the request host is used.
NEXT_PUBLIC_SITE_URL=
# Uploaded images go to files under DATA_DIR/assets, unless both of these are set (Supabase Storage)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 1 keeps the passwordless test sign-in in a production build (staging only)
DEV_SIGN_IN=
# Payments (Stripe, test mode). Without STRIPE_SECRET_KEY everyone is on Free and the upgrade button says payments are off.
# Secret key: Stripe Dashboard -> Developers -> API keys (sk_test_...)
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<site>/api/stripe/webhook (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Price id of the monthly Pro price (price_...)
STRIPE_PRICE_PRO=
# Email (sign-in links, invites, @mentions). Any SMTP server, e.g. smtps://user:password@smtp.example.ru:465
# (a Russian transactional service such as Unisender Go, or Yandex 360). Resend's API is the alternative.
# Without either, emails are skipped and logged; in development the sign-in link is shown on the page.
SMTP_URL=
RESEND_API_KEY=
# Sender, on a domain verified with the mail service, e.g. Мысль <hello@your-domain>
EMAIL_FROM=
# Protects /api/cron/purge (daily trash purge); Vercel Cron sends it as "Authorization: Bearer ..."
CRON_SECRET=
