# Signs short-lived realtime tokens shared by the web app and the realtime server
REALTIME_SECRET=
# Where the browser reaches the realtime server
NEXT_PUBLIC_REALTIME_URL=ws://localhost:1234
REALTIME_PORT=1234
# Data layer: "local" (JSON file in .data/, for development) or "postgres" (Supabase or any Postgres)
DATA_LAYER=local
# Postgres connection string; on Supabase: Project Settings -> Database -> Connection string (session pooler)
DATABASE_URL=
# Public address of the site, used in sign-in links (defaults to the request host)
NEXT_PUBLIC_SITE_URL=
# Supabase Auth turns on when these two are set and DATA_LAYER=postgres
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 1 keeps the passwordless test sign-in in a production build (staging only)
DEV_SIGN_IN=
# Payments (Stripe, test mode). Without STRIPE_SECRET_KEY everyone is on Free and the upgrade button says payments are off.
# Secret key: Stripe Dashboard -> Developers -> API keys (sk_test_...)
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<site>/api/stripe/webhook (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Price id of the monthly Pro price (price_...)
STRIPE_PRICE_PRO=
RESEND_API_KEY=
