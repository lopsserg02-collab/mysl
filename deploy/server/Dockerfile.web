# The web app (Next.js) on your own machine. Built from the repository root:
#   docker build -f deploy/server/Dockerfile.web .
# NEXT_PUBLIC_* values are baked into the browser code at build time, so they come in as build arguments.
FROM node:22-slim AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_REALTIME_URL
ARG BUILD_VERSION
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL NEXT_PUBLIC_REALTIME_URL=$NEXT_PUBLIC_REALTIME_URL RENDER_GIT_COMMIT=$BUILD_VERSION
RUN npm run build && npm prune --omit=dev && npm cache clean --force

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 DATA_LAYER=postgres DATA_DIR=/data
COPY --from=build /app/package.json /app/next.config.ts /app/tsconfig.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/.next ./.next
COPY --from=build /app/db ./db
COPY --from=build /app/scripts ./scripts
RUN mkdir -p /data && chown node /data
USER node
EXPOSE 3000
# Brings the database up to date (roles and auth schema for plain Postgres, then new migrations), then serves.
CMD ["sh", "-c", "node_modules/.bin/tsx scripts/migrate.ts --dev-stub && exec node_modules/.bin/next start -p 3000"]
