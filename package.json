{
  "name": "mysl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,rt \"next dev -p 3000\" \"tsx watch server/realtime.ts\"",
    "dev:web": "next dev -p 3000",
    "dev:rt": "tsx server/realtime.ts",
    "build": "next build",
    "start": "concurrently -k -n web,rt \"next start -p 3000\" \"tsx server/realtime.ts\"",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test lib/**/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:dev": "tsx scripts/migrate.ts --dev-stub"
  },
  "dependencies": {
    "@hocuspocus/extension-database": "^4.7.0",
    "@hocuspocus/provider": "^4.7.0",
    "@hocuspocus/server": "^4.7.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "jspdf": "^4.2.1",
    "konva": "^10.7.1",
    "lucide-react": "^1.52.0",
    "nanoid": "^5.1.0",
    "next": "^16.3.8",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "^19.3.0",
    "server-only": "^0.0.1",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.33",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
